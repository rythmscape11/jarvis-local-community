# All engine URLs must be loopback. No cloud inference or telemetry.
JARVIS_PORT=8765
JARVIS_MODEL=qwen3:4b-instruct
OLLAMA_URL=http://127.0.0.1:11437
OLLAMA_HOST=127.0.0.1:11437
OLLAMA_NO_CLOUD=1
WHISPER_URL=http://127.0.0.1:8178
WHISPER_MODEL=models/ggml-small.bin
# JARVIS_DATA=/absolute/private/directory
# JARVIS_MODELS=/absolute/model/directory
# JARVIS_APPLICATIONS={"Calculator":"com.apple.calculator","TextEdit":"com.apple.TextEdit","Safari":"com.apple.Safari"}
# Optional Google Calendar Desktop OAuth client JSON. NEVER commit credentials.
# GOOGLE_CLIENT_FILE=/absolute/private/client.json

# Workflow analysis stays local; configure workflow_model in Settings.
# Google Desktop OAuth JSON belongs outside the repository.
# GOOGLE_CLIENT_FILE=/absolute/private/path/to/desktop-client.json
# Never link billing or save API keys here; use the app OS-keyring controls.
